#include <stdio.h>

int main()
{
    int temp;
    int total = 0;
    int count = 0;
    int i;

    for(i = 1; i <= 7; i++)
    {
        printf("Enter temperature for day %d: ", i);
        scanf("%d", &temp);

        total = total + temp;

        if(temp > 100)
        {
            count++;
        }
    }

    printf("\nTotal temperature = %d\n", total);
    printf("Temperatures greater than 100 = %d\n", count);

    return 0;
}
